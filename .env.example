# Copy this file to .env (API — read by `vercel dev`) and/or
# .env.development.local (frontend — read by `npm start`) and fill in real
# values. Never commit a file containing real values — both are gitignored.

# --- Frontend (must be prefixed REACT_APP_ to reach the browser bundle) ---
REACT_APP_API_BASE_URL=http://localhost:3001/api

# --- API (server-side only, never shipped to the browser) ---
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
ALLOWED_ORIGIN=http://localhost:3000

# Long random value signing the session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Seed-script-only (scripts/seed-admin-user.mjs) — the one Admin account's
# credentials. Safe to remove from your local .env after running the script
# once; never logged, never committed.
ADMIN_EMAIL=admin@techticks.dev
ADMIN_PASSWORD=
